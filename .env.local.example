# Supabase (Optional - remove if not using backend)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Paperless-ngx Integration (optional)
# PAPERLESS_URL=http://localhost:8000
# PAPERLESS_TOKEN=your_paperless_api_token_here
# PAPERLESS_AVIS_TAG=

# Paperless-ngx Correspondents für eBon-Import (optional)
# Separate Correspondent IDs für jede Supermarktkette
# Finde die IDs in Paperless-ngx: Settings → Correspondents
# PAPERLESS_REWE_CORRESPONDENT_ID=1
# PAPERLESS_LIDL_CORRESPONDENT_ID=2
# PAPERLESS_KAUFLAND_CORRESPONDENT_ID=3

# Paperless-ngx AVIS Integration (nur REWE)
# PAPERLESS_AVIS_CORRESPONDENT_ID=1
# PAPERLESS_AVIS_DOCUMENT_TYPE_ID=3
# PAPERLESS_DOCUMENT_TYPE_ID=2

# Paperless-ngx Bestellbestätigung Integration (PROJ-32)
# PAPERLESS_BESTELLUNG_TAG=
# PAPERLESS_BESTELLUNG_CORRESPONDENT_ID=1
# PAPERLESS_BESTELLUNG_DOCUMENT_TYPE_ID=4

# Add more environment variables as needed
# STRIPE_SECRET_KEY=sk_...
# SMTP_HOST=smtp.sendgrid.net
# SMTP_USER=your_smtp_user
# SMTP_PASS=your_smtp_password
